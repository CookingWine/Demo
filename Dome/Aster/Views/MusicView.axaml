<?xml version="1.0" encoding="utf-8"?>
<!-- ==========================================================================
     MusicView.axaml —— 音乐播放器：左曲库 / 中唱片与控制 / 右可视化与队列，三栏布局
     位置：ShellView 有 MusicViewModel 到 MusicView 的 DataTemplate，但一级导航只有「管理 / 设置」，
           本页当前未挂到一级导航，属于未启用的保留模块。
     数据：全部来自 MusicViewModel（假播放），页面里没有任何真实音频控件。
     坑：本页样式写在 UserControl.Styles 里，只对本页生效；改模板名 Border#Bg 会同时打断悬停/选中选择器。
     坑："!IsPlaying" 这类取反绑定是 Avalonia 语法，不是 C# 运算符，删掉感叹号会编译失败。
     ========================================================================== -->
<!-- 三栏结构示意（整页只有一层 Grid，ColumnDefinitions=286,*,224）：
     ┌───────────────┬───────────────────────────────┬──────────────┐
     │ 左 286 定宽    │ 中 *（吸收全部缩放增量）        │ 右 224 定宽   │
     │ #24000000 底   │ 径向光晕铺底（Panel 跨三行）     │ #24000000 底  │
     │ 右侧 1px 分隔  │ 46 顶栏：正在播放 + LOSSLESS    │ 左侧 1px 分隔 │
     │ Auto 标题两行  │ *  唱片 212 + 歌名 + 三行歌词    │ 42  小标题    │
     │ Auto 筛选页签  │ Auto 控制区：进度 / 5 按钮 / 音量 │ 120 频谱画布  │
     │ *    曲库列表  │                               │ Auto 2x2 参数 │
     │ Auto 底部两钮  │                               │ Auto 队列标题 │
     └───────────────┴───────────────────────────────┴──────────────┘
     左右定宽的理由很直接：286 保证歌名与时长在同一行放得下（再窄就要靠省略号），
     224 保证 18 根频谱柱有足够画布；中间 * 拿走窗口缩放的全部增量，所以拉宽窗口时只有主舞台变宽。
     三栏底色都是 #24000000（约 14% 黑）叠在窗口底色上，仅用 1px Line 描边分界，
     所以视觉是"三块玻璃贴在一起"，而不是三张带圆角的卡片。 -->
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.ViewModels"
             xmlns:ctrl="using:Aster.Controls"
             x:Class="Aster.Views.MusicView"
             x:DataType="vm:MusicViewModel">

  <!-- 本页样式全部内联在 UserControl.Styles：只作用于 MusicView，不污染全局 Styles/Controls.axaml。 -->
  <UserControl.Styles>
    <!-- Button.song：曲库行。默认 Button 模板的内容层自带 padding、居中与圆角背景， -->
    <!-- 既不能保证「整行可点」，也无法让背景随选中态整体变色，所以换成自定义 ControlTemplate： -->
    <!-- 内容包进具名 Border#Bg，Padding 用 TemplateBinding 接回按钮自身的 Padding，内容横向拉伸撑满 286 栏宽。 -->
    <!-- 背景改由 #Bg 控制后，下面的 :pointerover / .selected 选择器就能用 /template/ 语法直接改写它。 -->
    <!-- 三个选择器的分工（改样式前必须先看懂这层）：
         Button.song                                    → 设按钮自身的属性（Padding / 对齐 / Template），不碰颜色；
         Button.song:pointerover /template/ Border#Bg   → 钻进模板内部，只改那个具名 Border 的 Background；
         Button.song.selected  /template/ Border#Bg     → 同上，条件是"带 selected 类"而不是悬停。
         /template/ 是 Avalonia 专属语法：斜杠之后的选择器只在 ControlTemplate 内部匹配；
         写成 Button.song Border#Bg 虽然也能命中，但会连带匹配内容里其它同名 Border，容易误伤。
         #Bg 是模板内的 Name（模板命名空间），按钮实例本身并不叫 Bg，所以从外部按名字找不到它。 -->
    <Style Selector="Button.song">
      <Setter Property="Padding" Value="9,7" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Template">
        <ControlTemplate>
          <Border Name="Bg" CornerRadius="7" Background="Transparent" Padding="{TemplateBinding Padding}">
            <ContentPresenter Content="{TemplateBinding Content}"
                              HorizontalContentAlignment="Stretch"
                              VerticalAlignment="Center" />
          </Border>
        </ControlTemplate>
      </Setter>
    </Style>
    <!-- 悬停：只改 #Bg 的底色（#0BFFFFFF 约 4% 白），不影响按钮其余部分。 -->
    <!-- 注意 #0BFFFFFF 是 8 位十六进制：前两位 0B 是 alpha（约 4.3%），后六位才是颜色。 -->
    <Style Selector="Button.song:pointerover /template/ Border#Bg">
      <Setter Property="Background" Value="#0BFFFFFF" />
    </Style>
    <!-- 选中：selected 类由 XAML 的 Classes.selected="{Binding IsSelected}" 控制，底色换成 13% 强调蓝。 -->
    <!-- 两条规则都命中 Border#Bg 且优先级相同，后声明的 .selected 会盖住先声明的 :pointerover， -->
    <!-- 所以鼠标划过"当前播放那一行"时保持蓝色选中底，不会退回更浅的悬停灰。 -->
    <!-- 类选择器的语义：Classes.selected="{Binding ...}" 为 true 时给按钮加 selected 类、为 false 时移除， -->
    <!-- 因此这个绑定一变，样式选择器立即重新求值，不需要重建行控件。 -->
    <Style Selector="Button.song.selected /template/ Border#Bg">
      <Setter Property="Background" Value="#216C8BFF" />
    </Style>

    <!-- Button.tab：筛选页签。透明底 + 去边框 + 26 高，靠左右 10px padding 撑出胶囊形点击区。 -->
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="26" />
      <Setter Property="Padding" Value="10,0" />
      <Setter Property="FontSize" Value="11.5" />
      <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    </Style>
    <!-- 页签悬停：W04 极淡白底提示可点，文字提亮一级。 -->
    <Style Selector="Button.tab:pointerover">
      <Setter Property="Background" Value="{DynamicResource W04}" />
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    </Style>
    <!-- 页签选中：半透明蓝底 + 浅蓝文字（#B9C8FF），比主强调色柔和，避免和播放按钮抢视觉。 -->
    <Style Selector="Button.tab.selected">
      <Setter Property="Background" Value="#296C8BFF" />
      <Setter Property="Foreground" Value="#B9C8FF" />
    </Style>

    <!-- Button.cbtn：32px 圆形图标按钮，播放控制、收藏、更多统一复用它。 -->
    <Style Selector="Button.cbtn">
      <Setter Property="Width" Value="32" />
      <Setter Property="Height" Value="32" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="CornerRadius" Value="16" />
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    </Style>
    <!-- 悬停只加一层 W06 底色，图标从 Text1 提亮到 Text0。 -->
    <Style Selector="Button.cbtn:pointerover">
      <Setter Property="Background" Value="{DynamicResource W06}" />
      <Setter Property="Foreground" Value="{DynamicResource Text0}" />
    </Style>
  </UserControl.Styles>

  <!-- ===== 三栏骨架 286 / * / 224 ===== -->
  <!-- 左右两栏定宽：曲库 286 保证歌名不被压扁，可视化 224 保证频谱有足够画布； -->
  <!-- 中间 * 吸收窗口缩放的全部增量，所以窗口变宽时只有主舞台变宽。 -->
  <Grid ColumnDefinitions="286,*,224">

    <!-- ==================== 播放列表 ==================== -->
    <!-- 左栏容器：半透明黑底 #24000000 + 右侧 1px Line 分隔，与中间舞台拉开层级。 -->
    <!-- 左栏内部自上而下分四段（RowDefinitions=Auto,Auto,*,Auto），只有曲库那一段是 *：
         ① 标题两行：LibraryTitle 15px SemiBold + LibrarySubtitle 11px Text2；
         ② 筛选页签：横向 ItemsControl，条目是 SegmentItem；
         ③ 曲库：ScrollViewer 包 ItemsControl，绑 VisibleSongs，吃满剩余高度；
         ④ 底部两个按钮：导入 / 新建歌单，各占一半宽，没有 Command。
         四段里只有 ③ 会随窗口高度伸缩，所以窗口变矮时先被压缩的是列表，标题与页签始终可见。 -->
    <Border Background="#24000000" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <!-- 四行：标题 / 筛选页签 / 可滚动曲库（*）/ 底部两个按钮；只有曲库行吃剩余高度。 -->
      <Grid RowDefinitions="Auto,Auto,*,Auto">
        <StackPanel Margin="16,16,16,10">
          <TextBlock Text="{Binding LibraryTitle}" FontSize="15" FontWeight="SemiBold" />
          <TextBlock Text="{Binding LibrarySubtitle}" FontSize="11" Foreground="{StaticResource Text2}" Margin="0,3,0,0" />
        </StackPanel>

        <!-- 页签横向排列（Spacing=4），每项是 SegmentItem：Label 作文案、IsSelected 决定 selected 类。 -->
        <ItemsControl Grid.Row="1" ItemsSource="{Binding Tabs}" Margin="12,0,12,8">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="4" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate DataType="{x:Type vm:SegmentItem}">
              <!-- Command 统一是 FilterCommand，CommandParameter 传条目本身；VM 侧目前按字符串取值，见那边的坑注释。 -->
              <!-- Classes.selected="{Binding IsSelected}" 是条件类：为 true 时给按钮挂上 selected，
                   于是 Button.tab.selected 那条样式（半透明蓝底 + #B9C8FF 字）生效；
                   SegmentItem 继承 SelectableItem，IsSelected 变化会自己发通知，但本工程里没人去改它。 -->
              <Button Classes="tab" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                      Command="{Binding Command}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- 曲库滚动区：只允许纵向滚动，横向禁用，防止超长歌名把整行推出视口。 -->
        <!-- 用的是 ScrollViewer + ItemsControl，而不是 ListBox：没有虚拟化，八行全部实时存在视觉树上，
             于是每行的 EqIndicator 都各有一个 120ms 计时器（挂到可视树就启动，Tick 里只在 IsVisible 时才重绘）。
             八条数据这个量级完全没问题，但若曲库变成几百首，这里要换 ListBox 或改成共享一个动画时钟。 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <!-- 绑 VisibleSongs 而不是 AllSongs：切页签时 VM 只重建这个集合。 -->
          <ItemsControl ItemsSource="{Binding VisibleSongs}" Margin="8,2,8,12">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:SongItem}">
                <!-- 整行是 Button.song：热区覆盖封面、文字、时长三列，点任意位置都能切歌。 -->
                <!-- 这个 DataTemplate 没写 x:Key，靠 DataType="{x:Type vm:SongItem}" 做隐式匹配：
                     ItemsControl 拿到每条数据后按运行时类型找模板，所以 VisibleSongs 里放什么类型就渲染成什么。
                     Command="{Binding Command}" 取的是 SongItem.Command（八首都指向同一个 SelectSongCommand），
                     CommandParameter="{Binding}" 则把"这一条 SongItem"本身当参数送回去 —— 两者缺一不可。 -->
                <Button Classes="song" Classes.selected="{Binding IsSelected}"
                        Command="{Binding Command}" CommandParameter="{Binding}">
                  <!-- Auto,*,Auto：34px 封面 / 自适应歌名 / 右侧状态区。 -->
                  <Grid ColumnDefinitions="Auto,*,Auto">
                    <!-- 封面是 34x34 圆角方块，背景直接绑 SongItem.Cover（渐变画刷）。 -->
                    <Border Width="34" Height="34" CornerRadius="6" Background="{Binding Cover}" />
                    <StackPanel Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center">
                      <TextBlock Text="{Binding Title}" FontSize="12" Foreground="{StaticResource Text0}"
                                 TextTrimming="CharacterEllipsis" />
                      <TextBlock Text="{Binding Artist}" FontSize="10.5" Foreground="{StaticResource Text2}"
                                 Margin="0,2,0,0" TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <!-- 右侧用一个 Panel 叠两层：跳动指示器与时长文案共用同一块位置。 -->
                    <!-- 选 Panel 而不是 StackPanel，是因为这里要的是"两个元素占同一格"的重叠语义：
                         Panel 不做行列划分，子元素各自按对齐方式落位，于是两层天然重合，互斥显示时代替彼此。 -->
                    <!-- 两层互斥由 IsPlaying 一个布尔两端取反实现（见下方两行注释），同一时刻只有一层参与布局。 -->
                    <!-- 一个如实的副作用：IsVisible=false 的子元素不参与测量，所以这一列的宽度会在状态切换时变化
                         （播放中只有 11px 的跳动条，暂停时变成 "4:12" 的文本宽度）。
                         中间那列是 *，于是歌名可用宽度会跟着差十几像素，肉眼几乎看不出来，但它确实存在。 -->
                    <Panel Grid.Column="2" VerticalAlignment="Center">
                      <!-- 正在播放时显示三格跳动指示器（自绘，内部跑 120ms 的 DispatcherTimer）。 -->
                      <ctrl:EqIndicator Width="11" Height="11" IsVisible="{Binding IsPlaying}" />
                      <!-- IsVisible="{Binding !IsPlaying}" 是 Avalonia 的取反绑定写法，等价于 !IsPlaying： -->
                      <!-- 播放中隐藏时长、暂停时隐藏跳动条，两者互斥显示，不会同时占位。 -->
                      <!-- 机制补一层：感叹号在这里属于绑定路径语法，会被编译成"读 IsPlaying 再取反"的节点，
                           不是 C# 运算符、也不需要值转换器；写成 {Binding IsPlaying, Converter=...} 是另一种等价写法。 -->
                      <TextBlock Text="{Binding Duration}" FontSize="10.5" Foreground="{StaticResource Text2}"
                                 IsVisible="{Binding !IsPlaying}" />
                    </Panel>
                  </Grid>
                </Button>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 左栏底部：导入 / 新建歌单，仅视觉占位，没有 Command。 -->
        <!-- 两列 * 等分 + ColumnSpacing=6 撑出缝隙；Height=26 比列表行更矮，明确它们是次要动作。 -->
        <Grid Grid.Row="3" ColumnDefinitions="*,*" Margin="14,10" ColumnSpacing="6">
          <Button Content="导入" FontSize="11" HorizontalAlignment="Stretch" Height="26" />
          <Button Grid.Column="1" Content="新建歌单" FontSize="11" HorizontalAlignment="Stretch" Height="26" />
        </Grid>
      </Grid>
    </Border>

    <!-- ==================== 播放主舞台 ==================== -->
    <!-- ===== 主舞台：46 顶栏 / * 唱片与歌词 / Auto 控制区 ===== -->
    <!-- RowDefinitions 46,*,Auto：中间行吃掉剩余高度；ClipToBounds 防止径向光晕溢出到左右栏。 -->
    <Grid Grid.Column="1" RowDefinitions="46,*,Auto" ClipToBounds="True">
      <!-- 背景层用 Panel + Grid.RowSpan=3 一次铺满三行：整块光晕连续，不会在行边界出现接缝。 -->
      <!-- 为什么要跨行而不是每行各画一层：径向渐变是按"自己的 Bounds"算中心与半径的（Center 50%,20%、Radius 75%），
           如果三行各放一个 Panel，就变成了三份独立的渐变，每份的 20% 都在自己那一行上，
           结果是三段光斑上下错位、边界处颜色跳变，看起来像三条不同的底纹拼起来。
           铺成一层后整块区域只算一次渐变，行只承担布局职责、不参与绘制。 -->
      <!-- 配套的两点：① 这个 Panel 没有设 Grid.Row，默认落在第 0 行，靠 RowSpan 覆盖到第 3 行；
           ② 父 Grid 设了 ClipToBounds="True"，否则半径 75% 的光晕会溢出到左右两栏上。 -->
      <!-- 还有一点：它是这个 Grid 的第一个子元素，声明顺序即 z 序，所以永远画在三行内容的下层；
           后面那几个 Grid.Row=0/1/2 的兄弟节点都覆盖在光晕之上。 -->
      <Panel Grid.RowSpan="3">
        <Panel.Background>
          <!-- 径向光晕：中心 50%,20%（偏上）、半径 75%，从 22% 透明紫过渡到全透明；#AARRGGBB 前两位是透明度。 -->
          <RadialGradientBrush Center="50%,20%" GradientOrigin="50%,20%" RadiusX="75%" RadiusY="75%">
            <GradientStop Offset="0" Color="#38A78BFA" />
            <GradientStop Offset="0.55" Color="#146C8BFF" />
            <GradientStop Offset="1" Color="#00000000" />
          </RadialGradientBrush>
        </Panel.Background>
      </Panel>

      <!-- 顶栏：左侧「正在播放」+ LOSSLESS 徽标，右侧收藏 / 更多两个圆形图标按钮。 -->
      <!-- 高度 46 由父 Grid 的 RowDefinitions 第一行给定，Border 只负责底部 1px 分隔线；
           Padding=24,0 让左侧文案的起点与唱片区、控制区的水平呼吸感一致（控制区两侧是 40）。 -->
      <Border Grid.Row="0" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="24,0">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
            <TextBlock Text="正在播放" FontSize="11.5" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
            <!-- LOSSLESS 徽标：12% 青底 + 20% 青边，纯装饰，不反映真实音频格式。 -->
            <Border CornerRadius="4" Padding="7,2" Background="#1F3DD6E8" BorderBrush="#333DD6E8" BorderThickness="1">
              <TextBlock Text="LOSSLESS" FontSize="10" Foreground="{StaticResource Cyan}" />
            </Border>
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <!-- 图标按钮的说明走 ToolTip.Tip（悬浮提示），不再额外占一行文字。 -->
            <!-- 这两个按钮显式把 cbtn 的 32 覆写成 26：顶栏只有 46 高，32 的圆会显得顶满，
                 26 才留得出上下各 10 的呼吸；Padding=0 + CornerRadius=16 来自 cbtn，圆形不会被压扁。 -->
            <Button Classes="cbtn" Width="26" Height="26" ToolTip.Tip="收藏">
              <ctrl:Icon Data="{x:Static ctrl:Icons.Heart}" Width="14" Height="14" />
            </Button>
            <Button Classes="cbtn" Width="26" Height="26" ToolTip.Tip="更多">
              <ctrl:Icon Data="{x:Static ctrl:Icons.More}" Width="14" Height="14" Filled="True" />
            </Button>
          </StackPanel>
        </Grid>
      </Border>

      <!-- 唱片与歌词 -->
      <!-- 整块用 VerticalAlignment=Center 在中栏剩余高度里垂直居中：窗口变高时上下留白均分，
           而不是把内容顶到顶栏下面；HorizontalAlignment=Center 让 212 的方形在任意宽度下都居中。
           Margin 0,10,0,0 是给顶栏那 1px 分隔线留的一点视觉余量。 -->
      <StackPanel Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="0,10,0,0">
        <!-- ===== 唱片区：212 外框 + 108 内部旋转盘 ===== -->
        <!-- 外框 Border 负责封面渐变、圆角与裁剪，SpinningDisc 只画黑色盘面、纹路和中心标签。 -->
        <!-- 尺寸关系：内盘 108 约为外框 212 的一半，四周留出封面色，视觉上像唱片压在封面上。 -->
        <!-- 外框 212x212 + 20 圆角 + ClipToBounds：内盘旋转时不会溢出圆角。 -->
        <!-- 三层层级从外到内，各自负责一件事：
             ① 外层 Border 212：只画渐变"封面色" + 20 圆角 + 裁剪，本身不旋转；
             ② 内层 SpinningDisc 108：画黑胶盘面、纹路、中心标签，只有它转（50ms 一次的角度累加，与播放进度无关）；
             ③ 再往里是控件自绘，没有 XAML 参与。
             外框不转、内盘转，是为了让"封面"稳定、"唱片"旋转，视觉上像一张唱片压在封套上。
             212 与 108 是设计给定的比例（约 2:1），四周留出的 52px 封面色正好是唱片的"露出边"。 -->
        <Border Width="212" Height="212" CornerRadius="20" ClipToBounds="True">
          <Border.Background>
            <!-- 封面渐变四段（232746 → 3D2F6B → 7C4FA3 → 2FA8C4），45° 斜向从深蓝紫过渡到青。 -->
            <LinearGradientBrush StartPoint="0%,0%" EndPoint="100%,100%">
              <GradientStop Offset="0" Color="#232746" />
              <GradientStop Offset="0.4" Color="#3D2F6B" />
              <GradientStop Offset="0.72" Color="#7C4FA3" />
              <GradientStop Offset="1" Color="#2FA8C4" />
            </LinearGradientBrush>
          </Border.Background>
          <!-- IsSpinning 绑 IsPlaying：暂停即停转；旋转角度由控件内部的 50ms 定时器累加，与播放进度无关。 -->
          <ctrl:SpinningDisc Width="108" Height="108" IsSpinning="{Binding IsPlaying}"
                             HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>

        <!-- 歌名 / 艺人：Title 与 Artist 都来自 VM，Artist 已拼上专辑名与年份。 -->
        <TextBlock Text="{Binding Title}" FontSize="20" FontWeight="SemiBold" Margin="0,20,0,0"
                   HorizontalAlignment="Center" />
        <TextBlock Text="{Binding Artist}" FontSize="12" Foreground="{StaticResource Text2}"
                   Margin="0,6,0,0" HorizontalAlignment="Center" />

        <!-- 三行歌词纯静态：中间行 13.5px 高亮，上下行 Opacity 降到 0.5 / 0.55 表示非当前行。 -->
        <StackPanel Spacing="3" Margin="0,16,0,0" HorizontalAlignment="Center">
          <TextBlock Text="{Binding LyricsLine0}" FontSize="12.5" Foreground="{StaticResource Text2}"
                     Opacity="0.5" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding LyricsLine1}" FontSize="13.5" FontWeight="Medium"
                     Foreground="#DDE3F2" HorizontalAlignment="Center" />
          <TextBlock Text="{Binding LyricsLine2}" FontSize="12.5" Foreground="{StaticResource Text2}"
                     Opacity="0.55" HorizontalAlignment="Center" />
        </StackPanel>
      </StackPanel>

      <!-- 控制区 -->
      <!-- ===== 控制区：进度条 + 传输按钮 + 音量 ===== -->
      <StackPanel Grid.Row="2" Margin="40,0,40,22">
        <!-- 进度行 Auto,*,Auto：两端时间各占 34px 固定宽，中间 TrackBar 吃掉剩余宽度。 -->
        <!-- 两端固定 34 是为了让进度条左右端点不随 "4:12" / "12:34" 的字符宽度抖动，切换曲目时轨道长度保持一致。 -->
        <Grid ColumnDefinitions="Auto,*,Auto" Margin="0,0,0,12">
          <TextBlock Text="{Binding PositionText}" FontSize="10.5" Foreground="{StaticResource Text2}"
                     Width="34" VerticalAlignment="Center" />
          <!-- TrackBar 的 Maximum 绑 DurationSeconds（秒）、Value 双向绑 Position（秒）——进度条本身不认百分比， -->
          <!-- 所以这里用 Position 而不是 Progress。拖动时 TrackBar 直接把新值写回 Position，由 setter 负责 Clamp。 -->
          <ctrl:TrackBar Grid.Column="1" Height="14" Value="{Binding Position, Mode=TwoWay}"
                         Maximum="{Binding DurationSeconds}" MinHeight="14" />
          <TextBlock Grid.Column="2" Text="{Binding DurationText}" FontSize="10.5" Foreground="{StaticResource Text2}"
                     Width="34" TextAlignment="Right" VerticalAlignment="Center" />
        </Grid>

        <!-- 传输按钮一组：随机 / 上一首 / 播放 / 下一首 / 循环 + 音量，Spacing=16 等距。 -->
        <!-- 五个按钮高度并不一致（32 的 cbtn 与 46 的主按钮），横向 StackPanel 默认按各自垂直居中排布，
             所以视觉上是以 46 那条中线对齐，不需要给每个按钮额外设 VerticalAlignment。 -->
        <!-- 随机 / 循环两个按钮的图标色绑 *Brush，不是文字色：开是 Accent 蓝、关是 #9BA3B7 中性灰。 -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="16">
          <!-- 随机 / 循环图标的前景色绑 *Brush 计算属性，开关切换时由 VM 手动通知刷新。 -->
          <Button Classes="cbtn" Command="{Binding ToggleShuffleCommand}" ToolTip.Tip="随机">
            <!-- ShuffleBrush：开启为 Accent 蓝、关闭为中性灰 #9BA3B7。 -->
            <ctrl:Icon Data="{x:Static ctrl:Icons.Shuffle}" Width="15" Height="15" Foreground="{Binding ShuffleBrush}" />
          </Button>
          <!-- 上一首 / 下一首是顺序命令，与随机开关无关（Prev 永远按列表回退）。 -->
          <Button Classes="cbtn" Command="{Binding PrevCommand}" ToolTip.Tip="上一首">
            <ctrl:Icon Data="{x:Static ctrl:Icons.Prev}" Width="15" Height="15" Filled="True" />
          </Button>

          <!-- 播放按钮外面套一层同尺寸 (46) 的透明 Border，只为承载辉光：BoxShadow="0 8 24 -8 #F26C8BFF"。 -->
          <!-- 阴影必须画在按钮外侧，而 Button 自身模板会裁剪外溢阴影，所以改用外层 Border 来画。 -->
          <!-- BoxShadow 五个参数依次是：offsetX=0、offsetY=8（往下偏 8，光晕沉在按钮下方）、 -->
          <!-- blur=24（模糊半径，决定柔和程度）、spread=-8（负扩散，让阴影轮廓比控件小一圈，只在边缘透出）、 -->
          <!-- color=#F26C8BFF（95% 不透明的强调蓝）。负 spread 是关键：正的会把整块区域糊成一片，负的才像"背面打光"。 -->
          <!-- 外层 Border 没有设 Background，所以它自己不画底色，只贡献阴影；CornerRadius=23 与按钮的 23 对齐，
               阴影形状才贴合那个正圆。 -->
          <Border Width="46" Height="46" CornerRadius="23" BoxShadow="0 8 24 -8 #F26C8BFF">
            <!-- 真正的按钮：46x46、圆角 23（正圆），背景用 PrimaryGrad 渐变，Command 绑 TogglePlayCommand。 -->
            <Button Width="46" Height="46" CornerRadius="23" Padding="0"
                    Background="{StaticResource PrimaryGrad}" BorderThickness="0"
                    Command="{Binding TogglePlayCommand}" ToolTip.Tip="播放/暂停">
              <!-- Icon.Data 直接绑 PlayIcon 字符串（播放/暂停的 path），Icon 内部 Geometry.Parse 后渲染。 -->
              <ctrl:Icon Data="{Binding PlayIcon}" Width="18" Height="18" Filled="True" Foreground="White" />
            </Button>
          </Border>

          <Button Classes="cbtn" Command="{Binding NextCommand}" ToolTip.Tip="下一首">
            <ctrl:Icon Data="{x:Static ctrl:Icons.Next}" Width="15" Height="15" Filled="True" />
          </Button>
          <Button Classes="cbtn" Command="{Binding ToggleRepeatCommand}" ToolTip.Tip="循环">
            <ctrl:Icon Data="{x:Static ctrl:Icons.Repeat}" Width="15" Height="15" Foreground="{Binding RepeatBrush}" />
          </Button>

          <!-- 音量组：喇叭图标 + 细进度条，整体靠 VerticalAlignment=Center 与传输按钮对齐。 -->
          <!-- 左边多留 8px（Margin 8,0,0,0）：把音量从"传输按钮"这一组里再往外推一点，暗示它是另一类控制。 -->
          <!-- 音量条 Width=64 是写死的，Maximum=100 也是字面量，与 Volume 的 0~100 约定必须人工保持一致。 -->
          <StackPanel Orientation="Horizontal" Spacing="8" Margin="8,0,0,0" VerticalAlignment="Center">
            <ctrl:Icon Data="{x:Static ctrl:Icons.Volume}" Width="14" Height="14"
                       Foreground="{StaticResource Text1}" VerticalAlignment="Center" />
            <!-- 音量条宽度固定 64，Maximum=100 写死，TrackHeight=3 比播放进度条更细。 -->
            <ctrl:TrackBar Width="64" Height="12" MinHeight="12" Maximum="100"
                           Value="{Binding Volume, Mode=TwoWay}" TrackHeight="3" />
          </StackPanel>
        </StackPanel>
      </StackPanel>
    </Grid>

    <!-- ==================== 右侧可视化 ==================== -->
    <!-- ===== 右栏：42 标题 / 120 频谱 / 参数网格 / 队列标题 / * 队列列表 ===== -->
    <!-- 五行里只有队列列表是 *，所以窗口变高时只有列表被拉长，其余区域高度稳定。 -->
    <Border Grid.Column="2" Background="#24000000" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
      <!-- RowDefinitions 42,Auto,Auto,Auto,*：除列表外全部按内容高度，列表占满剩余空间。 -->
      <Grid RowDefinitions="42,Auto,Auto,Auto,*">
        <TextBlock Text="音频可视化" FontSize="11" Foreground="{StaticResource Text2}"
                   Margin="16,0" VerticalAlignment="Center" />

        <!-- AudioBars：自绘 18 根频谱柱；IsPlaying 绑播放状态，暂停时柱高降到接近静止。 -->
        <!-- 高度 120，上下留白 16 / 8，柱条从底边向上生长。 -->
        <Border Grid.Row="1" Height="120" Padding="18,16,18,8">
          <ctrl:AudioBars IsPlaying="{Binding IsPlaying}" />
        </Border>

        <!-- 2x2 参数表：码率 / 采样 / 声道 / 格式，全部是写死的静态文本（没有真实解码信息）。 -->
        <!-- 四格的读法统一：上排 13px SemiBold 是"值"，下排 10.5px Text2 是"单位 / 含义"。 -->
        <!-- 一个绑定都没有：它们与 AllSongs 里任何一首都不关联，换曲、暂停、切随机、改音量都不会让这四个数字变化。 -->
        <!-- 布局：ColumnDefinitions=*,* 两列等宽 + RowDefinitions=Auto,Auto 两行按内容高；
             第二行两个格子各加 Margin 0,10,0,0 拉开行距，比给 Grid 设 RowSpacing 更可控（只影响第二行）。 -->
        <Grid Grid.Row="2" ColumnDefinitions="*,*" RowDefinitions="Auto,Auto" Margin="18,6,18,14">
          <StackPanel>
            <TextBlock Text="1411" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="kbps 码率" FontSize="10.5" Foreground="{StaticResource Text2}" />
          </StackPanel>
          <StackPanel Grid.Column="1">
            <TextBlock Text="44.1" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="kHz 采样" FontSize="10.5" Foreground="{StaticResource Text2}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Margin="0,10,0,0">
            <TextBlock Text="Stereo" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="声道" FontSize="10.5" Foreground="{StaticResource Text2}" />
          </StackPanel>
          <StackPanel Grid.Row="1" Grid.Column="1" Margin="0,10,0,0">
            <TextBlock Text="FLAC" FontSize="13" FontWeight="SemiBold" />
            <TextBlock Text="格式" FontSize="10.5" Foreground="{StaticResource Text2}" />
          </StackPanel>
        </Grid>

        <!-- 队列标题行用 0,1,0,0 的上边框与参数区隔开。 -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="16,12,16,8">
          <TextBlock Text="播放队列 · 接下来 6 首" FontSize="10.5" Foreground="{StaticResource Text2}" />
        </Border>

        <!-- 队列列表绑 Queue（PlainRow 的 Index / Text）：只读展示，点击不会切歌。 -->
        <!-- 数据是构造时用 Skip(1).Take(6) 一次性定下的，因此它既不跟随当前曲、也不跟随随机开关，
             永远是"第 2 到第 7 首"这六行；标题里"接下来 6 首"的 6 就是这里的 Take(6)。 -->
        <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <ItemsControl ItemsSource="{Binding Queue}" Margin="10,0,10,14">
            <ItemsControl.ItemTemplate>
              <DataTemplate DataType="{x:Type vm:PlainRow}">
                <!-- 每行 Auto,*：12px 序号列 + 歌名，超长用 TextTrimming 省略。 -->
                <Grid ColumnDefinitions="Auto,*" Margin="8,7" Height="18">
                  <TextBlock Text="{Binding Index}" FontSize="10" Foreground="{StaticResource Text2}"
                             Width="12" VerticalAlignment="Center" />
                  <TextBlock Grid.Column="1" Text="{Binding Text}" FontSize="11.5" Foreground="{StaticResource Text1}"
                             TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>
      </Grid>
    </Border>
  </Grid>
</UserControl>
