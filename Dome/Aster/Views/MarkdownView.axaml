<?xml version="1.0" encoding="utf-8"?>
<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Aster.ViewModels"
             xmlns:ctrl="using:Aster.Controls"
             x:Class="Aster.Views.MarkdownView"
             x:DataType="vm:MarkdownViewModel">

  <!-- ==========================================================================
       Markdown 文档模块视图：三栏结构
       左「文件树」212px 固定 / 中「编辑区」自适应 / 右「预览区」420px 固定
       数据来源：MarkdownViewModel，已声明 x:DataType，所有绑定均为编译期校验的类型化绑定
       启用状态：该模块当前已从一级导航移除、未在大厅启用，视图与 VM 一并保留待恢复
       易踩的坑：三列宽度在这里只是初始值，运行时由 MarkdownView.axaml.cs 的 ApplyMode 覆写；
                 行号栏 Gutter 的 RenderTransform 也不在此声明，而是后台代码注入的
       ========================================================================== -->
  <UserControl.Styles>
    <!-- 分组标题按钮：铺满宽度、无边框，仅悬停时给一层淡背景 -->
    <Style Selector="Button.tgroup">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="7,5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Margin" Value="0,4,0,0" />
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
      <Setter Property="FontSize" Value="11.5" />
    </Style>
    <Style Selector="Button.tgroup:pointerover">
      <Setter Property="Background" Value="{DynamicResource W04}" />
    </Style>

    <!-- 文件节点按钮：比分组标题略高，圆角 5，选中态由 Classes.selected 叠加下面那条样式 -->
    <Style Selector="Button.tfile">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="HorizontalContentAlignment" Value="Stretch" />
      <Setter Property="Padding" Value="7,5,7,5" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="CornerRadius" Value="5" />
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
      <Setter Property="FontSize" Value="12" />
    </Style>
    <Style Selector="Button.tfile:pointerover">
      <Setter Property="Background" Value="{DynamicResource W04}" />
      <Setter Property="Foreground" Value="{DynamicResource Text0}" />
    </Style>
    <!-- 文件节点选中态：淡蓝底 + 强调色文字；由 DocItem.IsSelected 通过 Classes.selected 触发 -->
    <Style Selector="Button.tfile.selected">
      <Setter Property="Background" Value="#246C8BFF" />
      <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
    </Style>

    <!-- 编辑区标签页：高 30，未选中用次要文字色，选中后换成更亮的底色与正文色 -->
    <Style Selector="Button.tab">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Height" Value="30" />
      <Setter Property="Padding" Value="11,0" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    </Style>
    <Style Selector="Button.tab:pointerover">
      <Setter Property="Background" Value="{DynamicResource W04}" />
      <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    </Style>
    <Style Selector="Button.tab.selected">
      <Setter Property="Background" Value="{DynamicResource Bg1}" />
      <Setter Property="Foreground" Value="{DynamicResource Text0}" />
    </Style>

    <!-- 标签页内的小图标按钮（关闭 × 等）：固定 22 见方、零内边距，只在悬停时提亮 -->
    <Style Selector="Button.docaction">
      <Setter Property="Background" Value="Transparent" />
      <Setter Property="BorderThickness" Value="0" />
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="22" />
      <Setter Property="Height" Value="22" />
      <Setter Property="MinHeight" Value="0" />
      <Setter Property="Foreground" Value="{DynamicResource Text2}" />
    </Style>
    <Style Selector="Button.docaction:pointerover">
      <Setter Property="Background" Value="{DynamicResource W08}" />
      <Setter Property="Foreground" Value="{DynamicResource Text0}" />
    </Style>
  </UserControl.Styles>

  <!-- 根容器：三列分别对应文件树 / 编辑区 / 预览区。
       x:Name 供 code-behind 取 ColumnDefinitions 做运行时的列宽改写（ApplyMode）。
       这里的宽度只是「编辑模式」下的初始形态，程序启动后一旦收到 Mode 变化就会被覆写。 -->
  <Grid x:Name="RootGrid">
    <Grid.ColumnDefinitions>
      <!-- 0：文件树，固定 212，不参与模式切换 -->
      <ColumnDefinition Width="212" />
      <!-- 1：编辑区，默认吃满剩余空间；分栏时被改成 3 份星号、预览模式下被改成 0 -->
      <ColumnDefinition Width="*" />
      <!-- 2：预览区，默认 Auto（由右侧 Border 自身的 Width 决定）；预览模式会被改成 1 份星号 -->
      <ColumnDefinition Width="Auto" />
    </Grid.ColumnDefinitions>

    <!-- ==================== 文件树 ==================== -->
    <!-- 左侧栏：半透明加深底色 + 右侧 1px 分隔线，与编辑区形成层次
         行结构固定为 42(标题) / Auto(搜索框) / *(可滚动树) / Auto(底部状态) -->
    <Border Background="#24000000" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
      <Grid RowDefinitions="42,Auto,*,Auto">

        <!-- 第 0 行：区块标题「工作区」与右侧的新建按钮 -->
        <Grid ColumnDefinitions="*,Auto" Margin="16,0,10,0">
          <TextBlock Text="工作区" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Text2}"
                     VerticalAlignment="Center" />
          <!-- 加号按钮当前没有绑定命令，只是占位的视觉元素 -->
          <Button Grid.Column="1" Classes="ghost" Width="22" Height="22" Padding="0" VerticalAlignment="Center">
            <ctrl:Icon Data="{x:Static ctrl:Icons.Plus}" Width="12" Height="12" Thickness="1.9" />
          </Button>
        </Grid>
        <!-- 标题行的下边框：单独用 1px Border 贴底，而不是给 Grid 设边线，避免影响高度计算 -->
        <Border Grid.Row="0" Height="1" Background="{StaticResource Line}" VerticalAlignment="Bottom" />

        <!-- 第 1 行：搜索框。Text 双向绑定 Search，每次输入都会触发 VM 里的 RebuildTree -->
        <Border Grid.Row="1" Height="27" Margin="12,10" CornerRadius="6"
                Background="{StaticResource W04}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                Padding="9,0">
          <Grid ColumnDefinitions="Auto,*">
            <ctrl:Icon Data="{x:Static ctrl:Icons.Search}" Width="12" Height="12"
                       Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
            <TextBox Grid.Column="1" Text="{Binding Search, Mode=TwoWay}" Watermark="筛选文件…"
                     Background="Transparent" BorderThickness="0" Padding="7,0" MinHeight="0"
                     FontSize="11.5" VerticalContentAlignment="Center" />
          </Grid>
        </Border>

        <!-- 第 2 行：分组树。只允许竖向滚动，横向禁用以免长文件名把布局撑破 -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
          <!-- 分组列表。ItemsSource 绑 Groups，VM 每次筛选都是整组 Clear + Add，这里靠集合通知重建 -->
          <ItemsControl ItemsSource="{Binding Groups}" Margin="8,2,8,14">
            <ItemsControl.ItemTemplate>
              <!-- 单个分组：一行标题按钮 + 一个可折叠的文档项列表 -->
              <DataTemplate DataType="{x:Type vm:DocGroup}">
                <StackPanel>
                  <!-- 分组标题行：命令参数传自身，VM 里翻转 IsExpanded -->
                  <Button Classes="tgroup" Command="{Binding ToggleCommand}" CommandParameter="{Binding}">
                    <Grid ColumnDefinitions="Auto,Auto,*,Auto">
                      <!-- 折角图标：Data 固定为一条折线，方向靠 ChevronTransform 旋转。
                           RenderTransformOrigin=50%,50% 让旋转围绕图标中心而不是左上角 -->
                      <ctrl:Icon Data="{x:Static ctrl:Icons.ChevronDown}" Width="12" Height="12"
                                 Foreground="{StaticResource Text2}" VerticalAlignment="Center"
                                 RenderTransform="{Binding ChevronTransform}" RenderTransformOrigin="50%,50%" />
                      <!-- 文件夹图标：颜色随分组 Tone 变化（accent / violet / muted） -->
                      <ctrl:Icon Grid.Column="1" Data="{x:Static ctrl:Icons.Folder}" Width="12" Height="12"
                                 Foreground="{Binding FolderBrush}" Margin="6,0,0,0" VerticalAlignment="Center" />
                      <TextBlock Grid.Column="2" Text="{Binding Name}" Margin="6,0,0,0" VerticalAlignment="Center" />
                      <!-- 右侧计数：all 态是假数据总量，筛选态是实际命中数 -->
                      <TextBlock Grid.Column="3" Text="{Binding Count}" FontSize="10"
                                 Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                    </Grid>
                  </Button>

                  <!-- 分组内的文档列表：折叠时不销毁，只靠 IsVisible 隐藏，展开后无需重建 -->
                  <ItemsControl ItemsSource="{Binding Items}" IsVisible="{Binding IsExpanded}">
                    <ItemsControl.ItemTemplate>
                      <!-- 单个文档节点 -->
                      <DataTemplate DataType="{x:Type vm:DocItem}">
                        <!-- Classes.selected 是条件类名：IsSelected 为 true 时才套用 .selected 样式 -->
                        <Button Classes="tfile" Classes.selected="{Binding IsSelected}"
                                Command="{Binding Command}" CommandParameter="{Binding}">
                          <Grid ColumnDefinitions="Auto,*,Auto">
                            <ctrl:Icon Data="{x:Static ctrl:Icons.Doc}" Width="12" Height="12"
                                       Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
                            <!-- 文件名：超长时省略号截断，避免撑破 212px 的侧栏 -->
                            <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="7,0,0,0"
                                       VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            <!-- 未保存标记：4px 见方、圆角 2（即正圆），琥珀色；IsDirty 为 false 时整块隐藏 -->
                            <Border Grid.Column="2" Width="4" Height="4" CornerRadius="2"
                                    Background="{StaticResource Amber}" VerticalAlignment="Center"
                                    IsVisible="{Binding IsDirty}" />
                          </Grid>
                        </Button>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>
                </StackPanel>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </ScrollViewer>

        <!-- 第 3 行：底部状态条。左侧文档总数（假数据固定值），右侧同步状态（当前写死） -->
        <Border Grid.Row="3" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="14,9">
          <Grid ColumnDefinitions="*,Auto">
            <TextBlock Text="{Binding DocCountText}" FontSize="10.5" Foreground="{StaticResource Text2}" />
            <TextBlock Grid.Column="1" Text="已同步" FontSize="10.5" Foreground="{StaticResource Text2}" />
          </Grid>
        </Border>
      </Grid>
    </Border>

    <!-- ==================== 编辑区 ==================== -->
    <!-- 第 1 列：行结构 42(标签栏) / 38(工具条) / *(编辑器本体)
         ClipToBounds=True 很关键：模式切换时列宽会瞬间变化，裁剪掉溢出内容才不会闪出半截控件 -->
    <Grid Grid.Column="1" x:Name="EditorPane" RowDefinitions="42,38,*" ClipToBounds="True">

      <!-- 标签页 -->
      <!-- 标签页栏：底部贴一条分隔线，标签本身垂直靠底对齐，模拟常见编辑器的页签形态 -->
      <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Background="#1A000000" Padding="12,0">
        <ItemsControl ItemsSource="{Binding Tabs}" VerticalAlignment="Bottom">
          <!-- 横向 StackPanel + 2px 间距，标签按打开顺序自左向右排列 -->
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" Spacing="2" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <!-- 单个标签：左侧是主按钮（点它切文档），右侧叠一个 × 关闭按钮 -->
            <DataTemplate DataType="{x:Type vm:EditorTab}">
              <Grid ColumnDefinitions="Auto,Auto">
                <!-- Padding 右侧收窄到 6，给叠上来的关闭按钮留出视觉空间 -->
                <Button Classes="tab" Classes.selected="{Binding IsSelected}"
                        Command="{Binding Command}" CommandParameter="{Binding}" Padding="11,0,6,0">
                  <StackPanel Orientation="Horizontal" Spacing="7">
                    <ctrl:Icon Data="{x:Static ctrl:Icons.Doc}" Width="12" Height="12"
                               Foreground="{StaticResource Accent}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding Name}" VerticalAlignment="Center" />
                  </StackPanel>
                </Button>
                <!-- 关闭按钮：Margin 左侧 -18 把自身叠到标签文字右侧，属于纯视觉叠放，不改 Grid 列结构 -->
                <Button Grid.Column="1" Classes="docaction" Width="16" Height="18" Margin="-18,0,4,0"
                        Command="{Binding CloseCommand}" CommandParameter="{Binding}"
                        Background="Transparent" VerticalAlignment="Center">
                  <TextBlock Text="×" FontSize="13" Foreground="{StaticResource Text2}" />
                </Button>
              </Grid>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </Border>

      <!-- 工具条 -->
      <!-- 工具条：面包屑（分组 / 文件名）· 保存状态 · 模式分段 · 导出按钮
           5 列依次为：面包屑 Auto / 弹性空隙 * / 保存状态 Auto / 分段 Auto / 导出 Auto -->
      <Border Grid.Row="1" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="14,0">
        <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto">
          <!-- 面包屑：两个只读文本靠 VM 的 CurrentGroup / CurrentName 派生属性驱动 -->
          <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
            <TextBlock Text="{Binding CurrentGroup}" FontSize="11.5" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
            <TextBlock Text="/" FontSize="11.5" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding CurrentName}" FontSize="11.5" Foreground="{StaticResource Text1}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- 保存状态：绿色小圆点（5px、圆角 3 即正圆）+ SaveState 文案 -->
          <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="5" VerticalAlignment="Center" Margin="0,0,14,0">
            <Border Width="5" Height="5" CornerRadius="3" Background="{StaticResource Green}" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SaveState}" FontSize="11" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
          </StackPanel>

          <!-- 模式分段控件：外层 Border 负责胶囊底，内层 ItemsControl 铺三个 SegmentItem 按钮 -->
          <Border Grid.Column="3" Classes="seg" VerticalAlignment="Center">
            <ItemsControl ItemsSource="{Binding Modes}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <StackPanel Orientation="Horizontal" Spacing="2" />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <!-- 每个选项的 Label 就是中文模式名，命令参数传自身，VM 据此调 SetMode -->
                <DataTemplate DataType="{x:Type vm:SegmentItem}">
                  <Button Classes="seg" Classes.selected="{Binding IsSelected}" Content="{Binding Label}"
                          Command="{Binding Command}" CommandParameter="{Binding}" />
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </Border>

          <!-- 导出按钮：尚未实现，纯装饰 -->
          <Button Grid.Column="4" Classes="ghost" Content="导出" Height="24" Padding="8,0" Margin="14,0,0,0"
                  VerticalAlignment="Center" FontSize="11.5" />
        </Grid>
      </Border>

      <!-- 编辑器 -->
      <!-- 编辑器：46px 行号栏 + 自适应文本区。整块 IsVisible 绑 ShowEditor，
           预览模式下隐藏；同时 RootGrid 会把本列宽度压到 0，双保险避免残留占位 -->
      <Grid Grid.Row="2" ColumnDefinitions="46,*" IsVisible="{Binding ShowEditor}">
        <!-- 行号栏容器：ClipToBounds 必须开，否则行号文本滚动偏移时会溢出到工具条或标签栏上。
             Gutter 的 RenderTransform 不在这里声明 —— 由 MarkdownView.axaml.cs 在 Loaded 时
             注入一个 TranslateTransform，随编辑器 ScrollViewer 的 Offset.Y 反向平移，做出同步滚动 -->
        <Panel ClipToBounds="True" Background="#12000000">
          <TextBlock x:Name="Gutter"
                     Text="{Binding LineNumbers}"
                     FontFamily="{StaticResource MonoFont}"
                     FontSize="12.2"
                     Foreground="#3A4152"
                     TextAlignment="Right"
                     LineHeight="21"
                     Padding="0,10,14,0"
                     Margin="0,0,0,0" />
        </Panel>

        <!-- 文本编辑区：Text 双向绑定 VM.Text（setter 会重算行号并置脏）。
             LineHeight 必须与 Gutter 的 21 严格一致，否则滚动时行号与正文会逐行错位。
             外层 Padding 底部留 40，让最后几行可以滚到视口中间，而不是被底边卡住 -->
        <TextBox Grid.Column="1" x:Name="Editor"
                 Text="{Binding Text, Mode=TwoWay}"
                 AcceptsReturn="True"
                 AcceptsTab="True"
                 TextWrapping="NoWrap"
                 FontFamily="{StaticResource MonoFont}"
                 FontSize="12.2"
                 LineHeight="21"
                 Background="#0C0E12"
                 BorderThickness="0"
                 Padding="0,10,24,40"
                 VerticalContentAlignment="Top"
                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                 ScrollViewer.HorizontalScrollBarVisibility="Hidden" />
      </Grid>
    </Grid>

    <!-- ==================== 预览区 ==================== -->
    <!-- 第 2 列：初始 Width=420 决定 RootGrid 第三列（Auto）的宽度；分栏模式下保持 420。
         切到「预览」模式时，code-behind 会把它改成 double.NaN（即 Auto，由内容撑满）并把列宽设为星号，
         于是整块右栏占满窗口；切回分栏时再还原成 420。IsVisible 绑 ShowPreview 负责纯编辑模式下的隐藏 -->
    <Border Grid.Column="2" x:Name="PreviewPane" Width="420"
            Background="#1F000000" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0"
            IsVisible="{Binding ShowPreview}">
      <Grid RowDefinitions="38,*">
        <!-- 预览标题栏：左侧眼睛图标 + 文案，右侧标注渲染风格 -->
        <Border BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="16,0">
          <Grid ColumnDefinitions="*,Auto">
            <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <ctrl:Icon Data="{x:Static ctrl:Icons.Eye}" Width="12" Height="12"
                         Foreground="{StaticResource Violet}" VerticalAlignment="Center" />
              <TextBlock Text="实时预览" FontSize="11" Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Grid.Column="1" Text="Markdown · GitHub 风格" FontSize="10.5"
                       Foreground="{StaticResource Text2}" VerticalAlignment="Center" />
          </Grid>
        </Border>

        <!-- 渲染器本体：纯控件树实现的轻量 Markdown 渲染，直接复用编辑器同一个 Text，
             因此输入即刷新，没有额外的事件或定时器参与 -->
        <ctrl:MarkdownPreview Grid.Row="1" Markdown="{Binding Text}" />
      </Grid>
    </Border>
  </Grid>
</UserControl>
