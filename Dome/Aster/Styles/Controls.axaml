<?xml version="1.0" encoding="utf-8"?>
<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">



  <!-- ===================== 基础 ===================== -->
  <Style Selector="Window">
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="FontSize" Value="13" />
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
  </Style>

  <Style Selector="ToolTip">
    <Setter Property="Background" Value="{DynamicResource Bg3}" />
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="FontSize" Value="11" />
    <Setter Property="Padding" Value="8,4" />
    <Setter Property="CornerRadius" Value="6" />
  </Style>

  <!-- ===================== 滚动条 ===================== -->
  <Style Selector="ScrollBar">
    <Setter Property="Background" Value="Transparent" />
  </Style>
  <Style Selector="ScrollBar /template/ Thumb">
    <Setter Property="Background" Value="#1CFFFFFF" />
    <Setter Property="CornerRadius" Value="9" />
  </Style>
  <Style Selector="ScrollBar:pointerover /template/ Thumb">
    <Setter Property="Background" Value="#33FFFFFF" />
  </Style>

  <!-- ===================== 通用按钮 ===================== -->
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="28" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Background" Value="{DynamicResource W04}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Cursor" Value="Hand" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="Button /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="CornerRadius" Value="6" />
  </Style>
  <Style Selector="Button:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource W08}" />
  </Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource W06}" />
  </Style>

  <Style Selector="Button.pri">
    <Setter Property="Background" Value="{DynamicResource PrimaryGrad}" />
    <Setter Property="BorderBrush" Value="{DynamicResource W14}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="FontWeight" Value="Medium" />
  </Style>
  <Style Selector="Button.pri:pointerover">
    <Setter Property="Foreground" Value="White" />
    <Setter Property="Opacity" Value="0.9" />
  </Style>
  <Style Selector="Button.pri:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource PrimaryGrad}" />
  </Style>
  <Style Selector="Button.pri:pressed">
    <Setter Property="Opacity" Value="0.82" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="{DynamicResource W06}" />
  </Style>

  <Style Selector="Button.link">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="MinHeight" Value="0" />
    <Setter Property="Height" Value="NaN" />
    <Setter Property="VerticalAlignment" Value="Center" />
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
    <Setter Property="FontSize" Value="11.5" />
  </Style>
  <Style Selector="Button.link:pointerover">
    <Setter Property="Foreground" Value="#9FB4FF" />
  </Style>
  <Style Selector="Button.link:pointerover /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Background" Value="Transparent" />
  </Style>

  <!-- ===================== 输入框 ===================== -->
  <Style Selector="TextBox">
    <Setter Property="Background" Value="{DynamicResource W04}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="7" />
    <Setter Property="Padding" Value="10,5" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="FontFamily" Value="{DynamicResource UiFont}" />
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
    <Setter Property="CaretBrush" Value="{DynamicResource Accent}" />
    <Setter Property="SelectionBrush" Value="#806C8BFF" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="{DynamicResource W06}" />
    <Setter Property="BorderBrush" Value="{DynamicResource W14}" />
  </Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement">
    <Setter Property="Background" Value="#126C8BFF" />
    <Setter Property="BorderBrush" Value="{DynamicResource Accent}" />
    <Setter Property="BoxShadow" Value="0 0 0 3 #246C8BFF" />
  </Style>

  <!-- ===================== 下拉框 ===================== -->
  <Style Selector="ComboBox">
    <Setter Property="Background" Value="{DynamicResource W06}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line2}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="10,0" />
    <Setter Property="MinHeight" Value="30" />
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
    <Setter Property="HorizontalAlignment" Value="Right" />
  </Style>
  <Style Selector="ComboBoxItem">
    <Setter Property="FontSize" Value="12" />
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
    <Setter Property="Padding" Value="10,6" />
    <Setter Property="MinHeight" Value="0" />
  </Style>

  <!-- ===================== 文本样式类 ===================== -->
  <Style Selector="TextBlock.t0"><Setter Property="Foreground" Value="{DynamicResource Text0}" /></Style>
  <Style Selector="TextBlock.t1"><Setter Property="Foreground" Value="{DynamicResource Text1}" /></Style>
  <Style Selector="TextBlock.t2"><Setter Property="Foreground" Value="{DynamicResource Text2}" /></Style>
  <Style Selector="TextBlock.accent"><Setter Property="Foreground" Value="{DynamicResource Accent}" /></Style>
  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFont}" />
    <Setter Property="FontSize" Value="11" />
  </Style>
  <Style Selector="TextBlock.label">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style Selector="TextBlock.groupTitle">
    <Setter Property="FontSize" Value="10.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text2}" />
  </Style>
  <Style Selector="TextBlock.pageTitle">
    <Setter Property="FontSize" Value="18" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
  </Style>
  <Style Selector="TextBlock.cardTitle">
    <Setter Property="FontSize" Value="12.5" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
  </Style>
  <Style Selector="TextBlock.metric">
    <Setter Property="FontSize" Value="26" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
  </Style>

  <!-- ===================== 卡片 / 分隔 ===================== -->
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource Bg2}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="11" />
    <Setter Property="ClipToBounds" Value="True" />
  </Style>
  <Style Selector="Border.pill">
    <Setter Property="CornerRadius" Value="999" />
    <Setter Property="Padding" Value="8,3" />
    <Setter Property="VerticalAlignment" Value="Center" />
  </Style>
  <Style Selector="Border.roleTag">
    <Setter Property="CornerRadius" Value="5" />
    <Setter Property="Padding" Value="8,2" />
    <Setter Property="Background" Value="{DynamicResource W04}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Border.seg">
    <Setter Property="Background" Value="{DynamicResource W04}" />
    <Setter Property="BorderBrush" Value="{DynamicResource Line}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="6" />
    <Setter Property="Padding" Value="2" />
  </Style>

  <!-- ===================== 标题栏按钮 ===================== -->
  <Style Selector="Button.chrome">
    <Setter Property="Theme" Value="{StaticResource ChromeButton}" />
  </Style>
  <Style Selector="Button.chrome:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
  </Style>
  <Style Selector="Button.chrome:pointerover /template/ Border#Bg">
    <Setter Property="Background" Value="{DynamicResource W08}" />
  </Style>
  <Style Selector="Button.chrome.close:pointerover">
    <Setter Property="Foreground" Value="White" />
  </Style>
  <Style Selector="Button.chrome.close:pointerover /template/ Border#Bg">
    <Setter Property="Background" Value="#E5484D" />
  </Style>

  <!-- ===================== 一级导航 ===================== -->
  <Style Selector="Button.nav">
    <Setter Property="Theme" Value="{StaticResource NavButton}" />
    <Setter Property="Width" Value="56" />
    <Setter Property="Height" Value="52" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.nav:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
  </Style>
  <Style Selector="Button.nav:pointerover /template/ Border#Bg">
    <Setter Property="Background" Value="{DynamicResource W04}" />
  </Style>
  <Style Selector="Button.nav.selected">
    <Setter Property="Foreground" Value="{DynamicResource Accent}" />
  </Style>
  <Style Selector="Button.nav.selected /template/ Border#Bg">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="#3A6C8BFF" />
  </Style>
  <Style Selector="Button.nav.selected /template/ Border#Bar">
    <Setter Property="Background" Value="{DynamicResource Accent}" />
    <Setter Property="BoxShadow" Value="0 0 12 0 #CC6C8BFF" />
  </Style>

  <!-- ===================== 二级导航 ===================== -->
  <Style Selector="Button.subnav">
    <Setter Property="Theme" Value="{StaticResource SubNavButton}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderBrush" Value="Transparent" />
    <Setter Property="BorderThickness" Value="1" />
  </Style>
  <Style Selector="Button.subnav:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
  </Style>
  <Style Selector="Button.subnav:pointerover /template/ Border#Bg">
    <Setter Property="Background" Value="{DynamicResource W04}" />
  </Style>
  <Style Selector="Button.subnav.selected">
    <Setter Property="Foreground" Value="{DynamicResource AccentText}" />
  </Style>
  <Style Selector="Button.subnav.selected /template/ Border#Bg">
    <Setter Property="Background" Value="{DynamicResource AccentSoft}" />
    <Setter Property="BorderBrush" Value="#336C8BFF" />
  </Style>

  <!-- ===================== 分段项 ===================== -->
  <Style Selector="Button.seg">
    <Setter Property="Theme" Value="{StaticResource SegButton}" />
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
  </Style>
  <Style Selector="Button.seg:pointerover">
    <Setter Property="Foreground" Value="{DynamicResource Text1}" />
  </Style>
  <Style Selector="Button.seg.selected">
    <Setter Property="Foreground" Value="{DynamicResource Text0}" />
    <Setter Property="Background" Value="{DynamicResource W10}" />
  </Style>

</Styles>
